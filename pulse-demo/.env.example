# Copy to .env and adjust. Both gateway and bridge read this file.
DEMIFY_URL=http://127.0.0.1:3000
# Only if Demify was started with DEMIFY_ADMIN_TOKEN (sent as x-demify-admin)
DEMIFY_ADMIN_TOKEN=
MQTT_URL=mqtt://127.0.0.1:1883
PORT=8443
# Random string; the phone link carries it as ?token=
PULSE_TOKEN=change-me-12c
CREW_ID=cdr
# Optional plain-HTTP port for the Chrome-flag fallback (off when empty)
HTTP_PORT=
# Demify repository (start-demo.ps1 starts it from here if it is not running)
DEMIFY_DIR=C:\Repos\NSAC\Demify---Health-Monitoring-Software-for-Astronauts
