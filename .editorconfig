# Editor settings shared by everyone who works on Demify. See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

# Two trailing spaces are a line break in Markdown, and prose is not wrapped.
[*.md]
trim_trailing_whitespace = false
max_line_length = off
