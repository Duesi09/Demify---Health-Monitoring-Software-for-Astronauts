# Demify onboard server (NVIDIA DGX Spark): settings for docker-compose.spark.yml
#
#   cp .env.spark.example .env
#   chmod 600 .env
#
# Then set POSTGRES_PASSWORD (required) and DEMIFY_ADMIN_TOKEN. Never commit
# .env (it is git-ignored). Guide: docs/SPARK.md. Every setting documented in
# .env.example works here too (mission, offline mode, data sources, proxy).

# Plain `docker compose ...` in this folder then uses the onboard server file
# instead of docker-compose.yml (the pitch setup).
COMPOSE_FILE=docker-compose.spark.yml

# ---------------------------------------------------------------------------
# PostgreSQL (REQUIRED)
# ---------------------------------------------------------------------------
# Empty on purpose: docker compose refuses to start until you set it.
# Use letters and digits only (it goes into DATABASE_URL as is), e.g.
#   sed -i "s/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=$(openssl rand -hex 24)/" .env
# It is applied when the database is created (first start on an empty
# volume). To change it later, also run ALTER USER in psql (docs/SPARK.md).
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Models (downloaded ONLY by the explicit step
#   docker compose --profile models run --rm model-pull)
# ---------------------------------------------------------------------------
# 128 GB of unified memory is shared by the CPU and the GPU. Approximate
# budget (see docs/SPARK.md):
#   gpt-oss:20b        ~14 GB   default, Apache-2.0, mixture of experts
#   gpt-oss:120b       ~65 GB   stronger answers, slower; still fits
#   nomic-embed-text   ~0.3 GB  embeddings, 768 dimensions
#   KV cache           a few GB (DEMIFY_OLLAMA_CONTEXT_LENGTH x NUM_PARALLEL)
#   PostgreSQL         ~2-4 GB  (shared_buffers 2 GB + work memory)
#   app + sync         up to 2.5 GB (container limits)
#   DGX OS, page cache and headroom: the rest. Keep at least ~30 GB free.
DEMIFY_LLM_MODEL=gpt-oss:20b
# Keep nomic-embed-text unless the database column changes too: the library
# stores 768-dimensional vectors.
DEMIFY_EMBED_MODEL=nomic-embed-text

# Model server image. Pin the version you tested (gpt-oss needs a recent
# Ollama with CUDA support for the GB10), e.g. ollama/ollama:<version>.
#DEMIFY_OLLAMA_IMAGE=ollama/ollama:latest
# Parallel requests per model and context length (tokens) per request.
#DEMIFY_OLLAMA_NUM_PARALLEL=2
#DEMIFY_OLLAMA_CONTEXT_LENGTH=8192

# Publish the model API on 127.0.0.1:<port> of this machine (e.g. 11434) for
# local tools. Unset = not published; the app reaches it inside Docker.
#DEMIFY_MODEL_BIND=11434

# ---------------------------------------------------------------------------
# Library sync
# ---------------------------------------------------------------------------
# Scheduled library sync from the ground folder (./library) while the ground
# link is up, in hours. "Sync now" in the app works at any time the link is up.
DEMIFY_SYNC_INTERVAL_HOURS=6
# The library counts as stale (shown with every answer) after this many hours.
DEMIFY_SYNC_MAX_AGE_HOURS=24

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------
# Admin token for the write APIs: drills, sensor readings, the ground link
# switch and "Sync now". Strongly recommended here, e.g. openssl rand -hex 24.
# Unlock a browser once with http://<host>:3000/unlock?token=<token>.
DEMIFY_ADMIN_TOKEN=

# Host address of the app port. 127.0.0.1 = this machine only. Set 0.0.0.0
# for crew tablets on the station LAN, and then DEMIFY_ADMIN_TOKEN as well.
DEMIFY_BIND=127.0.0.1
DEMIFY_PORT=3000

# ---------------------------------------------------------------------------
# Mission and behaviour (same as .env.example)
# ---------------------------------------------------------------------------
DEMIFY_MISSION=iss
DEMIFY_MISSION_START=
# true = hard air-gap: the ground link stays down whatever the switch says.
DEMIFY_OFFLINE=false
DEMIFY_SIMULATE=true

# ---------------------------------------------------------------------------
# Proxy (optional; empty = direct connection)
# ---------------------------------------------------------------------------
# Used for live data and model downloads. The container names (db, model,
# app, sync) are always in NO_PROXY; add your own hosts here.
DEMIFY_HTTPS_PROXY=
DEMIFY_HTTP_PROXY=
DEMIFY_NO_PROXY=
# TLS-intercepting proxy: put its CA (PEM) in ./certs/ca.crt (git-ignored).
# Build: npm ci in the image build needs it as a BuildKit secret (it is not
# stored in the image).
#DEMIFY_BUILD_CA=./certs/ca.crt
# Run time (live data in app and sync): uncomment the ./certs/ca.crt volume
# under app and sync in docker-compose.spark.yml, then set
#DEMIFY_NODE_EXTRA_CA_CERTS=/etc/demify/ca.crt
# Model downloads (model service): see docs/SPARK.md, troubleshooting.

# ---------------------------------------------------------------------------
# Container limits
# ---------------------------------------------------------------------------
DEMIFY_IMAGE=demify:latest
DEMIFY_CPUS=4.0
DEMIFY_MEMORY=2G
DEMIFY_DB_MEMORY=12G
