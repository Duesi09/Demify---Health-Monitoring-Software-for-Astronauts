# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# ...except the empty build-CA placeholder docker-compose.yml needs (see docs/DEPLOYMENT.md)
!/docker/no-extra-ca.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.spark.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local CA bundles for Docker builds behind a proxy (see docs/DEPLOYMENT.md)
/certs/
