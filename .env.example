# Demify configuration
# Copy to .env (read automatically by `docker compose`) or pass with
# `docker run --env-file .env`. All variables are optional; the values below
# are the defaults. Never commit a real .env (it is git-ignored).

# ---------------------------------------------------------------------------
# Mission / behaviour
# ---------------------------------------------------------------------------

# Mission profile: iss | artemis-lunar | mars-transit
# Sets baseline radiation dose rate, comm delay, gravity and mission duration.
DEMIFY_MISSION=iss

# true = never call external APIs; serve the bundled/last-known snapshots only.
# Use on air-gapped spacecraft networks or for deterministic demos.
DEMIFY_OFFLINE=false

# Seconds a live API response is kept in memory before refetching.
DEMIFY_CACHE_TTL=300

# Timeout (ms) for each outbound API request. Raise on slow/high-latency links;
# lower to fall back to snapshots faster when the link is down.
DEMIFY_FETCH_TIMEOUT_MS=8000

# true = generate demo telemetry (heart rate, blood pressure, SpO2 ...) for the
# crew. Set to false when real sensor readings are entered/imported.
DEMIFY_SIMULATE=true

# ---------------------------------------------------------------------------
# Storage (paths INSIDE the container; the image defaults are shown)
# ---------------------------------------------------------------------------

# Persistent crew readings (demify-db.json). Must be a volume.
DEMIFY_DATA_DIR=/data

# Offline snapshots of the external APIs. The image ships them read-only in
# /app/data/snapshots-seed; the entrypoint copies missing files here on start
# and the app refreshes them after every successful live fetch.
DEMIFY_SNAPSHOT_DIR=/data/snapshots

# true = overwrite snapshots in DEMIFY_SNAPSHOT_DIR with the ones bundled in the
# image on next start (e.g. after shipping a newer image to an offline system).
DEMIFY_RESEED_SNAPSHOTS=false

# ---------------------------------------------------------------------------
# External data sources (point these at a ground relay / mirror if needed)
# ---------------------------------------------------------------------------

# api.nasa.gov key. DEMO_KEY works but is heavily rate limited.
# Get a free key at https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY

# NASA Open Science Data Repository (OSDR) API
OSDR_BASE_URL=https://osdr.nasa.gov

# OSDR biological data / visualization API
OSDR_BIODATA_URL=https://visualization.osdr.nasa.gov

# NOAA Space Weather Prediction Center (radiation, Kp, X-ray flux)
SWPC_BASE_URL=https://services.swpc.noaa.gov

# ---------------------------------------------------------------------------
# Behind a proxy / custom CA
# ---------------------------------------------------------------------------
# Node's built-in fetch ignores proxy variables unless NODE_USE_ENV_PROXY=1,
# which the image already sets. Leave these empty for a direct connection.
#
# docker-compose.yml maps these DEMIFY_-prefixed names onto HTTPS_PROXY,
# HTTP_PROXY, NO_PROXY and NODE_EXTRA_CA_CERTS inside the container (so the
# proxy of your own shell is never passed in by accident). With plain
# `docker run`, set the standard names directly:
#   docker run -e HTTPS_PROXY=http://proxy.example:3128 -e NO_PROXY=localhost,127.0.0.1 ...
DEMIFY_HTTPS_PROXY=
DEMIFY_HTTP_PROXY=
# Hosts that bypass the proxy (keep localhost so the health check stays local).
DEMIFY_NO_PROXY=localhost,127.0.0.1

# Extra PEM CA bundle for TLS-intercepting proxies or private mirrors. This is a
# path INSIDE the container: uncomment the CA volume in docker-compose.yml
#   - ./certs/ca.crt:/etc/demify/ca.crt:ro
# and set DEMIFY_NODE_EXTRA_CA_CERTS=/etc/demify/ca.crt
DEMIFY_NODE_EXTRA_CA_CERTS=

# Build time (docker compose build): PEM CA bundle for npm behind a
# TLS-intercepting proxy, passed as a BuildKit secret (not stored in the image).
#DEMIFY_BUILD_CA=./certs/ca.crt
# Private npm registry mirror for the build.
#NPM_CONFIG_REGISTRY=https://registry.npmjs.org/

# ---------------------------------------------------------------------------
# docker compose only (not read by the app)
# ---------------------------------------------------------------------------

# Host port for the app (and for the air-gapped `offline` profile relay).
DEMIFY_PORT=3000
DEMIFY_OFFLINE_PORT=3001
# Host interface to bind; use 127.0.0.1 when a reverse proxy runs on the host.
DEMIFY_BIND=0.0.0.0
# Image tag built/used by compose (e.g. registry.example/demify:1.2.0)
DEMIFY_IMAGE=demify:latest
# Container resource limits
DEMIFY_CPUS=1.0
DEMIFY_MEMORY=512M
