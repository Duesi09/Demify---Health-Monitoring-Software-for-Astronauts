# Demify configuration
# Copy to .env (read automatically by `docker compose`) or pass with
# `docker run --env-file .env`. All variables are optional; the values below
# are the defaults. Never commit a real .env (it is git-ignored).

# ---------------------------------------------------------------------------
# Mission / behaviour
# ---------------------------------------------------------------------------

# Mission profile: iss | artemis-lunar | mars-transit
# Sets baseline radiation dose rate, comm delay, gravity and mission duration.
DEMIFY_MISSION=iss

# Mission start date (ISO 8601, e.g. 2026-09-01). Drives "mission day" and the
# mission dose budget. Empty = 92 days before the server started (demo mode;
# moves on every restart, so set it for a real mission). Invalid values are
# ignored with a warning in the log, as is an unknown DEMIFY_MISSION (-> iss).
DEMIFY_MISSION_START=

# true = never call external APIs; serve the bundled/last-known snapshots only.
# Use on air-gapped spacecraft networks or for deterministic demos.
DEMIFY_OFFLINE=false

# Seconds a live API response is kept in memory before refetching.
DEMIFY_CACHE_TTL=300

# Timeout (ms) for each outbound API request. Raise on slow/high-latency links;
# lower to fall back to snapshots faster when the link is down.
DEMIFY_FETCH_TIMEOUT_MS=8000

# true = generate demo telemetry (heart rate, blood pressure, SpO2 ...) for the
# crew. Set to false when real sensor readings are entered/imported.
DEMIFY_SIMULATE=true
# Healthy simulated crew (pitch demo, default true): no scripted health
# stories, every simulated crew member nominal. false brings back the
# stories (commander stress, MS2 sleep debt, pilot under-drinking and
# raised blood pressure, MS1 raised heart rate).
#DEMIFY_HEALTHY_CREW=true

# ---------------------------------------------------------------------------
# Storage (paths INSIDE the container; the image defaults are shown)
# ---------------------------------------------------------------------------
# docker-compose.yml pins DEMIFY_DATA_DIR and DEMIFY_SNAPSHOT_DIR to the data
# volume, so setting them here has no effect with Compose; they are listed for
# `docker run --env-file`. Outside Docker (npm run dev / npm start) the
# defaults are relative to the working directory, shown in brackets.

# Persistent crew readings (demify-db.json). Must be a volume.
# [local: data]
DEMIFY_DATA_DIR=/data

# Writable offline snapshots of the external APIs. The entrypoint copies
# missing files here from DEMIFY_SNAPSHOT_SEED_DIR on start, and the app
# refreshes them after every successful live fetch.
# [local: data/runtime/snapshots, git-ignored]
DEMIFY_SNAPSHOT_DIR=/data/snapshots

# Read-only snapshots bundled with the release (committed in data/snapshots,
# baked into the image). Read alongside DEMIFY_SNAPSHOT_DIR; whichever copy
# has the newer fetchedAt wins.
# `npm run snapshots:promote` copies refreshed snapshots from
# DEMIFY_SNAPSHOT_DIR into this dir so the next release ships them.
# [local: data/snapshots]
#DEMIFY_SNAPSHOT_SEED_DIR=/app/data/snapshots-seed

# Crew readings older than this many days are pruned from the store on write.
# Keep it longer than the mission (Mars transit profile: 900 days).
DEMIFY_RETENTION_DAYS=1100

# Hard cap on stored readings; oldest sensor readings are evicted first.
DEMIFY_MAX_READINGS=50000

# Max readings accepted per crew member per minute on POST /api/readings.
DEMIFY_RATE_LIMIT_PER_MIN=600

# ---------------------------------------------------------------------------
# Write protection (recommended on a stage or any shared network)
# ---------------------------------------------------------------------------

# Optional admin token. Empty = the write APIs stay open (as before).
# When set, POST/DELETE /api/scenarios (drills) and POST /api/readings
# (sensors) answer 401 unless the request carries the token:
#   - devices and scripts: header  x-demify-admin: <token>
#   - a browser: open http://<host>:3000/unlock?token=<token> once; it sets an
#     httpOnly, SameSite=Strict cookie and redirects to the overview. The
#     cookie stays valid for 7 days or until the token changes. Unlock before
#     you share your screen: `npm run dev` logs the /unlock URL with the token.
# Reading pages and GET APIs stay open. Use a long random value, e.g.
#   openssl rand -hex 24
# and never commit it. Changing it is the only way to revoke unlocked
# browsers. With a token set, run
#   DEMIFY_ADMIN_TOKEN=<token> npm run sensor:demo
# (or export it first); the script sends it as x-demify-admin. npm run does
# not read this .env file, so the token set here does not reach the script.
DEMIFY_ADMIN_TOKEN=

# true = overwrite snapshots in DEMIFY_SNAPSHOT_DIR with the ones bundled in the
# image on next start (e.g. after shipping a newer image to an offline system).
DEMIFY_RESEED_SNAPSHOTS=false

# ---------------------------------------------------------------------------
# External data sources (point these at a ground relay / mirror if needed)
# ---------------------------------------------------------------------------

# api.nasa.gov key. DEMO_KEY works but is heavily rate limited.
# Get a free key at https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY

# NASA Open Science Data Repository (OSDR) API
OSDR_BASE_URL=https://osdr.nasa.gov

# OSDR biological data / visualization API
OSDR_BIODATA_URL=https://visualization.osdr.nasa.gov

# NOAA Space Weather Prediction Center (radiation, Kp, X-ray flux)
SWPC_BASE_URL=https://services.swpc.noaa.gov

# ---------------------------------------------------------------------------
# Behind a proxy / custom CA
# ---------------------------------------------------------------------------
# Node's built-in fetch ignores proxy variables unless NODE_USE_ENV_PROXY=1,
# which the image already sets. Leave these empty for a direct connection.
#
# docker-compose.yml maps these DEMIFY_-prefixed names onto HTTPS_PROXY,
# HTTP_PROXY, NO_PROXY and NODE_EXTRA_CA_CERTS inside the container (so the
# proxy of your own shell is never passed in by accident). With plain
# `docker run`, set the standard names directly:
#   docker run -e HTTPS_PROXY=http://proxy.example:3128 -e NO_PROXY=localhost,127.0.0.1 ...
DEMIFY_HTTPS_PROXY=
DEMIFY_HTTP_PROXY=
# Hosts that bypass the proxy (keep localhost so the health check stays local).
# docker-compose.yml always adds host.docker.internal (a model server on this
# machine, see below).
DEMIFY_NO_PROXY=localhost,127.0.0.1

# Extra PEM CA bundle for TLS-intercepting proxies or private mirrors. This is a
# path INSIDE the container: uncomment the CA volume in docker-compose.yml
#   - ./certs/ca.crt:/etc/demify/ca.crt:ro
# and set DEMIFY_NODE_EXTRA_CA_CERTS=/etc/demify/ca.crt
DEMIFY_NODE_EXTRA_CA_CERTS=

# Build time (docker compose build): PEM CA bundle for npm behind a
# TLS-intercepting proxy, passed as a BuildKit secret (not stored in the image).
#DEMIFY_BUILD_CA=./certs/ca.crt
# Private npm registry mirror for the build.
#NPM_CONFIG_REGISTRY=https://registry.npmjs.org/

# ---------------------------------------------------------------------------
# Onboard assistant: local model and onboard server (optional)
# ---------------------------------------------------------------------------
# All unset by default. Unset, Demify runs exactly as described above: JSON
# file store, no language model, the library read from the bundled files.
#
# Local model on this machine (pitch laptop, docs/LOCAL-MODEL.md):
# `npm run model:setup` (Windows: scripts/setup-local-model.ps1) pulls the
# model into Ollama and adds these two lines to .env; docker-compose.yml
# passes them (and DEMIFY_EMBED_MODEL, DEMIFY_LLM_TIMEOUT_MS and
# DEMIFY_ASSISTANT_MIN_SCORE) to the container:
#   DEMIFY_MODEL_URL=http://host.docker.internal:11434/v1
#   DEMIFY_LLM_MODEL=gemma3:4b
# docker-compose.yml has no database: the assistant finds passages in the
# bundled library by keyword search and the model only phrases the answer
# from them.
#
# Onboard server (NVIDIA DGX Spark, docs/SPARK.md): docker-compose.spark.yml
# sets all of these for its containers (its settings are in
# .env.spark.example). The list below is for `npm run dev` or `docker run`.
#
# PostgreSQL 17 + pgvector: crew readings, the onboard library, sync history
# and the ground link switch. Unset: the JSON file store.
#DATABASE_URL=postgres://demify:<password>@127.0.0.1:5432/demify
# OpenAI-compatible endpoint of the local model server (Ollama, vLLM, ...).
# Unset: the onboard assistant shows matching library passages only.
#DEMIFY_MODEL_URL=http://127.0.0.1:11434/v1
#DEMIFY_LLM_MODEL=gpt-oss:20b
#DEMIFY_EMBED_MODEL=nomic-embed-text
#DEMIFY_EMBED_DIM=768
#DEMIFY_LLM_TIMEOUT_MS=90000
#DEMIFY_EMBED_TIMEOUT_MS=20000
#DEMIFY_ASSISTANT_MIN_SCORE=0.5
#DEMIFY_ASSISTANT_TOP_K=3
# Keep the local model loaded (a one-token request at most every 4 min while
# Demify is open). false = let Ollama unload it after 5 idle minutes.
#DEMIFY_MODEL_KEEP_WARM=true
# The folder that plays the Earth-side library, and the release copy that
# seeds an empty database (both ./library; /app/library in the image).
#DEMIFY_GROUND_LIBRARY_DIR=./library
#DEMIFY_SEED_LIBRARY_DIR=./library
# Sync service (npm run sync:service, or the sync container): library sync
# every N hours while the ground link is up, stale after M hours.
#DEMIFY_SYNC_INTERVAL_HOURS=6
#DEMIFY_SYNC_MAX_AGE_HOURS=24
#DEMIFY_SYNC_TICK_SECONDS=60
#DEMIFY_SNAPSHOT_REFRESH_MINUTES=30
#DEMIFY_APP_URL=http://127.0.0.1:3000
#DEMIFY_SYNC_HEARTBEAT=/tmp/demify-sync-heartbeat

# ---------------------------------------------------------------------------
# docker compose only (not read by the app)
# ---------------------------------------------------------------------------

# Host port for the app (and for the air-gapped `offline` profile relay).
DEMIFY_PORT=3000
DEMIFY_OFFLINE_PORT=3001
# Host address the published ports listen on (both services). The default
# 127.0.0.1 keeps Demify reachable from this machine only, which is what a
# stage laptop or a host with a reverse proxy wants. Set 0.0.0.0 to let other
# devices on the LAN (crew tablets, sensor hubs) connect, and then also set
# DEMIFY_ADMIN_TOKEN above.
DEMIFY_BIND=127.0.0.1
# Image tag built/used by compose (e.g. registry.example/demify:1.2.0)
DEMIFY_IMAGE=demify:latest
# Container resource limits
DEMIFY_CPUS=1.0
DEMIFY_MEMORY=512M
