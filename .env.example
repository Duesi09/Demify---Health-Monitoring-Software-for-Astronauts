# Settings of the Demify server. Copy this file to .env and remove the "#" in
# front of what you want to change. Never commit .env.
#
# Who reads .env:
#   npm run dev, npm run build, npm start   Next.js loads it by itself.
#   docker compose up                       Compose passes on the settings named in compose.yaml.

# Directory where readings entered by hand are kept.
# Default: .data in the project directory. The container image always uses
# /data, the mounted volume, so Compose does not pass this setting on.
# DEMIFY_DATA_DIR=.data

# How readings are stored: sqlite (default) or json. See docs/data.md.
# DEMIFY_STORE=sqlite

# Token that callers of the HTTP API under /api/v1 must present (16 to 512
# characters, no spaces). Without it the crew endpoints of the API are switched
# off; the app itself works either way. Treat it like a password. See docs/api.md.
# DEMIFY_API_TOKEN=
